# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude .tfvars files that may contain sensitive data (passwords, private keys, secrets).
# terraform.tfvars is explicitly un-ignored below because our environment tfvars files
# contain only non-sensitive values (bucket name suffixes, tags, region).
# Never put secrets in terraform.tfvars — use GitHub Secrets / environment variables instead.
*.tfvars
*.tfvars.json

# Un-ignore the standard terraform.tfvars files — these are safe to commit.
# Secret values must NEVER be placed in these files.
!terraform.tfvars
!environments/*/terraform.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc
